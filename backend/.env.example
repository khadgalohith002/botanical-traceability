# PhytoTrace FastAPI Backend Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Neo4j Property Graph Database (Optional - falls back to NetworkX in-memory graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://*.netlify.app
